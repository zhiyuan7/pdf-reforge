DEEPSEEK_API_KEY=your_key_here

# Daily CNY ceiling shared by all jobs (Asia/Shanghai calendar day).
PDF_REFORGE_DAILY_BUDGET_CNY=48

# Optional Docker host port; the container always listens on 8765.
PDF_REFORGE_PORT=8765

# Optional NVIDIA device ID when using compose.gpu.yaml.
PDF_REFORGE_GPU_ID=0
